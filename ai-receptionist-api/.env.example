NODE_ENV=development
PORT=4000

# PostgreSQL
# Change username/password/port if your local PostgreSQL installation differs.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_receptionist?schema=public"

# Google AI Studio API key. Never expose this in Next.js/browser code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Seed creates a demo business. You can put its ID here after running the seed.
DEFAULT_BUSINESS_ID=""

# Optional application timezone. Store timestamps in UTC; use this for business-facing display.
DEFAULT_TIMEZONE="Asia/Dhaka"

CORS_ORIGIN="http://localhost:3000"
